# Copy to .env and fill in.  ->  cp .env.example .env
# .env is gitignored; secrets never go through git.

# ─────────────────────────────────────────────────────────────────────────
# LLM BACKEND SELECTOR
# ─────────────────────────────────────────────────────────────────────────
# One switch decides where the agent's LLM calls go. The agent is just an
# OpenAI-compatible HTTP client, so this is the ONLY thing that changes
# between local dev and the final H100 run.
#
#   nebius : hosted Qwen3-30B-A3B on Nebius Token Factory  (DEV DEFAULT)
#            same model as the H100, so prompts transfer 1:1. Needs a key.
#   h100   : your own vLLM serving the 30B at localhost:8000 (the FINAL run)
#   cpu    : your own vLLM serving tiny Qwen3-0.6B on CPU at localhost:8000
#            (Stage A.5 - only to validate /metrics plumbing, not quality)
#   openai : plain OpenAI gpt-4o-mini - throwaway dev fallback. Needs a key.
#
# Explicit VLLM_BASE_URL / VLLM_MODEL below always override the profile.
LLM_BACKEND=nebius

# ─────────────────────────────────────────────────────────────────────────
# KEYS  (only the one matching your profile is needed)
# ─────────────────────────────────────────────────────────────────────────
# Nebius Token Factory key (profile=nebius). Get it at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
# OpenAI key (profile=openai). Leave blank otherwise.
OPENAI_API_KEY=
# HuggingFace token - only needed on the H100 so vLLM can download the model.
HF_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
# EXPLICIT OVERRIDES (optional)
# ─────────────────────────────────────────────────────────────────────────
# Uncomment to override the profile's defaults. The model id must match what
# vLLM actually serves (e.g. an FP8/AWQ/GPTQ variant changes this string).
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Sampling / client knobs (defaults shown). temperature=0 keeps evals
# reproducible; bump LLM_TIMEOUT if the H100 cold-starts slowly.
# LLM_TEMPERATURE=0.0
# LLM_TIMEOUT=60

# ─────────────────────────────────────────────────────────────────────────
# LANGFUSE  (Phase 4 - fill in after creating a project at localhost:3001)
# ─────────────────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
